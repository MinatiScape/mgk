CONFIG_SYSVIPC=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_VT=y
CONFIG_NULL_TTY=y
CONFIG_DEVTMPFS=y
# CONFIG_LTO_CLANG_FULL=y will fail without a LOT of RAM
CONFIG_LTO_CLANG_THIN=y
# bluebinder
CONFIG_BT_HCIVHCI=y
CONFIG_CMDLINE="bootopt=64S3,32N2,64N2 systempart=/dev/mapper/system printk.devkmsg=on log_buf_len=4M break=init"
